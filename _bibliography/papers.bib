  year         = {2026},
  howpublished = {Neural Networks course project, University of Padova},
  abstract     = {We compare three families of architectures for 4-class brain tumor MRI classification (glioma, meningioma, pituitary tumor, no tumor) under a single protocol and without synthetic data augmentation: a convolutional autoencoder with frozen encoder and MLP head, a ResNet-50 (ImageNet-pretrained and from scratch) and a fully fine-tuned ViT-B/16. Pretrained ResNet-50 and ViT-B/16 reach 95.3% and 95.1% test accuracy respectively, while glioma remains the hardest class for all models.},
